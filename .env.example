# --- core ---
PORT=5001
NODE_ENV=development
# where the FRONTEND is served — payment links are built as <PUBLIC_URL>/payment.html
# in production this is the site path, e.g. https://tour-rider.com/rides
PUBLIC_URL=http://localhost:3000
# comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,https://tour-rider.com

# --- database ---
DB_CONNECT_STRING=mongodb+srv://user:pass@cluster/tr

# --- auth ---
JWT_SECRET=

# --- email (SMTP via nodemailer) ---
# leave SMTP_HOST blank to use Gmail; set it for any other SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tour Rider <booking@tour-rider.com>
ADMIN_EMAIL=

# --- Square ---
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2023-08-16

# --- business rules ---
DEPOSIT_RATE=0.5
QUOTE_LINK_TTL_DAYS=7
