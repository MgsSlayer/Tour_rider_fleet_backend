# --- core ---
PORT=5001
NODE_ENV=development
# where the FRONTEND is served — payment links are built as <PUBLIC_URL>/payment.html
# in production this is the site path, e.g. https://tour-rider.com/rides
PUBLIC_URL=http://localhost:3000
# comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000,https://tour-rider.com

# --- database ---
DB_CONNECT_STRING=mongodb+srv://user:pass@cluster/tr

# --- auth ---
JWT_SECRET=

# --- email (SMTP via nodemailer) ---
# leave SMTP_HOST blank to use Gmail; set it for any other SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Tour Rider <booking@tour-rider.com>
ADMIN_EMAIL=

# --- Square ---
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_API_VERSION=2023-08-16

# PayPal and Venmo. Leave blank and both buttons stay hidden.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- business rules ---
DEPOSIT_RATE=0.2
QUOTE_LINK_TTL_DAYS=7

# ── timezone ─────────────────────────────────────────
# where the fleet operates — pickup times are wall-clock in this zone
FLEET_TZ=America/New_York

# ── price suggestions (optional) ──────────────────────
# server-side Maps key with Routes + Directions enabled — IP-restricted, NOT the
# browser key in config.js. Without it, suggestions are simply unavailable.
GOOGLE_MAPS_API_KEY=
# repositioning: applied when a pickup is >40mi or >1h from the NEAREST saved
# base. Bases are managed in the admin dashboard, not here.
REPOSITION_FEE=150
TAX_RATE=0.08875
DEFAULT_TIP_RATE=0.20

# ── open quote requests ───────────────────────────────
# the fleet sheet the site lists; open requests are matched against it server-side.
# The key needs the Sheets API enabled and no HTTP-referrer restriction.
# Leave SHEETS_API_KEY blank to use GOOGLE_MAPS_API_KEY with Sheets enabled on it.
SHEET_ID=1eCD0tvBgKIUcrbff0ee-QYz7O8ltQWe5TZackzg8bq8
SHEET_NAME=Fleetsheet
SHEETS_API_KEY=

# surcharge by method: card/Apple Pay/Google Pay/PayPal, then Venmo/Cash App.
# Zelle and cash are never surcharged.
PROCESSING_FEE_STANDARD=0.04
PROCESSING_FEE_REDUCED=0.02

# Zelle phone or email, and the name the customer's bank shows for it.
# Leave blank for the defaults: 917-822-2713, received by ITON COLLECTION LLC (Tour Rider's parent company)
# If these change, replace frontend/img/pay/zelle-qr.jpg too; it is the QR for that account
ZELLE_RECIPIENT=
ZELLE_RECIPIENT_NAME=
CONTACT_PHONE=917-822-2713
